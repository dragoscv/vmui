# vmui — TEMPLATE for .private/credentials.env
#
# Copy this file to .private/credentials.env and fill in real values:
#
#   mkdir .private
#   cp .private.example/credentials.env .private/credentials.env
#
# .private/ is gitignored; this template is tracked and must contain NO real
# credentials. Consumed by scripts/lib/guest-credentials.{sh,ps1}.
#
# Any value already exported in the environment wins over this file, so CI can
# inject credentials without writing them to disk.

# macOS guest (OSX-KVM, ssh 127.0.0.1:10022)
MAC_GUEST_USER=dragos
MAC_GUEST_PASS=CHANGE_ME

# Windows 11 guest (Hyper-V / QEMU, ssh 127.0.0.1:10023)
WIN_GUEST_USER=dragos
WIN_GUEST_PASS=CHANGE_ME

# Ubuntu guest (QEMU, ssh 127.0.0.1:10024)
UBUNTU_GUEST_USER=dragos
UBUNTU_GUEST_PASS=CHANGE_ME

# Apple Screen Sharing on :5901. The RFB protocol caps VNC passwords at 8
# characters, so this is usually a truncated form of the account password.
MAC_VNC_PASS=CHANGE_M
