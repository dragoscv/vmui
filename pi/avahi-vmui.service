<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- /etc/avahi/services/vmui.service — installed by scripts/pi-deploy.ps1.
     Lets the phone/desktop apps find vmui on the LAN as homepi.local:3737
     (_vmui._tcp) without typing an address. -->
<service-group>
  <name replace-wildcards="yes">vmui on %h</name>
  <service>
    <type>_vmui._tcp</type>
    <port>3737</port>
    <txt-record>path=/api/discover</txt-record>
    <txt-record>v=1</txt-record>
  </service>
</service-group>
